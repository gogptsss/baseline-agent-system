{
  "mcpServers": {
    "web-fetch": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-fetch"
      ]
    },
    "web-browser": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-puppeteer"
      ]
    },
    "web-search": {
      "command": "npx",
      "args": [
        "-y",
        "mcp-server-tavily"
      ],
      "env": {
        "TAVILY_API_KEY": "YOUR_TAVILY_KEY"
      }
    }
  }
}